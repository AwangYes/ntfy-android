<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_theme_primary</item>
        <item name="colorOnPrimary">@color/md_theme_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_onPrimaryContainer</item>
        <item name="colorSecondary">@color/md_theme_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_theme_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_onSecondaryContainer</item>
        <item name="colorTertiary">@color/md_theme_tertiary</item>
        <item name="colorOnTertiary">@color/md_theme_onTertiary</item>
        <item name="colorTertiaryContainer">@color/md_theme_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/md_theme_onTertiaryContainer</item>
        <item name="colorError">@color/md_theme_error</item>
        <item name="colorOnError">@color/md_theme_onError</item>
        <item name="colorErrorContainer">@color/md_theme_errorContainer</item>
        <item name="colorOnErrorContainer">@color/md_theme_onErrorContainer</item>
        <item name="android:colorBackground">@color/md_theme_background</item>
        <item name="colorOnBackground">@color/md_theme_onBackground</item>
        <item name="colorSurface">@color/md_theme_surface</item>
        <item name="colorOnSurface">@color/md_theme_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_onSurfaceVariant</item>
        <item name="colorOutline">@color/md_theme_outline</item>
        <item name="colorOutlineVariant">@color/md_theme_outlineVariant</item>
        <item name="colorSurfaceInverse">@color/md_theme_inverseSurface</item>
        <item name="colorOnSurfaceInverse">@color/md_theme_inverseOnSurface</item>
        <item name="colorPrimaryInverse">@color/md_theme_inversePrimary</item>
        <item name="colorPrimaryFixed">@color/md_theme_primaryFixed</item>
        <item name="colorOnPrimaryFixed">@color/md_theme_onPrimaryFixed</item>
        <item name="colorPrimaryFixedDim">@color/md_theme_primaryFixedDim</item>
        <item name="colorOnPrimaryFixedVariant">@color/md_theme_onPrimaryFixedVariant</item>
        <item name="colorSecondaryFixed">@color/md_theme_secondaryFixed</item>
        <item name="colorOnSecondaryFixed">@color/md_theme_onSecondaryFixed</item>
        <item name="colorSecondaryFixedDim">@color/md_theme_secondaryFixedDim</item>
        <item name="colorOnSecondaryFixedVariant">@color/md_theme_onSecondaryFixedVariant</item>
        <item name="colorTertiaryFixed">@color/md_theme_tertiaryFixed</item>
        <item name="colorOnTertiaryFixed">@color/md_theme_onTertiaryFixed</item>
        <item name="colorTertiaryFixedDim">@color/md_theme_tertiaryFixedDim</item>
        <item name="colorOnTertiaryFixedVariant">@color/md_theme_onTertiaryFixedVariant</item>
        <item name="colorSurfaceDim">@color/md_theme_surfaceDim</item>
        <item name="colorSurfaceBright">@color/md_theme_surfaceBright</item>
        <item name="colorSurfaceContainerLowest">@color/md_theme_surfaceContainerLowest</item>
        <item name="colorSurfaceContainerLow">@color/md_theme_surfaceContainerLow</item>
        <item name="colorSurfaceContainer">@color/md_theme_surfaceContainer</item>
        <item name="colorSurfaceContainerHigh">@color/md_theme_surfaceContainerHigh</item>
        <item name="colorSurfaceContainerHighest">@color/md_theme_surfaceContainerHighest</item>

        <!-- iOS-like system chrome and typography -->
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:windowBackground">@color/ios_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/ios_light_system_bars</item>
        <item name="colorControlHighlight">@color/ios_ripple</item>
        <item name="actionBarSize">@dimen/ios_nav_bar_height</item>
        <item name="dialogPreferredPadding">@dimen/ios_screen_padding</item>
        <item name="actionMenuTextColor">?attr/colorPrimary</item>
        <item name="actionMenuTextAppearance">@style/TextAppearance.Ios.ActionMenu</item>

        <!-- Rounded, low-elevation controls -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Ios.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Ios.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Ios.Large</item>
        <item name="materialButtonStyle">@style/Widget.Ios.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Ios.Button.Outlined</item>
        <item name="materialCardViewStyle">@style/Widget.Ios.Card</item>
        <item name="textInputStyle">@style/Widget.Ios.TextInputLayout</item>
        <item name="floatingActionButtonStyle">@style/FloatingActionButton</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Ios.MaterialAlertDialog</item>

        <item name="windowActionModeOverlay">true</item>
        <item name="searchViewStyle">@style/AppSearchViewStyle</item>

        <item name="actionModeStyle">@style/ActionMode</item>
        <item name="actionModeCloseButtonStyle">@style/ActionModeCloseButtonStyle</item>
        <item name="actionOverflowButtonStyle">@style/OverflowButtonStyle</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.Ios</item>
    </style>

    <!-- Shared shapes -->
    <style name="ShapeAppearance.Ios.Small" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
    <style name="ShapeAppearance.Ios.Medium" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/ios_card_radius</item>
    </style>
    <style name="ShapeAppearance.Ios.Large" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>
    <style name="ShapeAppearance.Ios.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Typography -->
    <style name="TextAppearance.Ios.LargeTitle" parent="TextAppearance.AppCompat.Headline">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">34sp</item>
        <item name="android:textColor">?attr/colorOnBackground</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.Ios.NavTitle" parent="TextAppearance.AppCompat.Title">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">?attr/colorOnBackground</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.Ios.CardTitle" parent="TextAppearance.AppCompat.Medium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.Ios.Body" parent="TextAppearance.AppCompat.Body1">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.Ios.Footnote" parent="TextAppearance.AppCompat.Small">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/ios_label_secondary</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.Ios.Caption" parent="TextAppearance.AppCompat.Caption">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/ios_label_tertiary</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.Ios.SectionHeader" parent="TextAppearance.AppCompat.Caption">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/ios_label_secondary</item>
        <item name="android:letterSpacing">0.04</item>
    </style>
    <style name="TextAppearance.Ios.ActionMenu" parent="TextAppearance.AppCompat.Widget.ActionBar.Menu">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- Buttons -->
    <style name="Widget.Ios.Button" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/ios_control_radius</item>
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="elevation">0dp</item>
        <item name="rippleColor">@color/ios_ripple</item>
    </style>
    <style name="Widget.Ios.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="rippleColor">@color/ios_ripple</item>
    </style>
    <style name="Widget.Ios.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">50dp</item>
        <item name="cornerRadius">@dimen/ios_control_radius</item>
        <item name="strokeColor">@color/ios_separator</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <!-- Cards and inputs -->
    <style name="Widget.Ios.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/ios_card</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Ios.Medium</item>
        <item name="rippleColor">@color/ios_ripple</item>
    </style>
    <style name="Widget.Ios.TextInputLayout" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@color/ios_card</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1dp</item>
        <item name="boxStrokeColor">@color/ios_separator</item>
        <item name="boxCornerRadiusTopStart">@dimen/ios_control_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/ios_control_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/ios_control_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/ios_control_radius</item>
        <item name="hintTextColor">?attr/colorPrimary</item>
        <item name="android:textColorHint">@color/ios_label_secondary</item>
    </style>
    <style name="Widget.Ios.TextInputLayout.OutlinedBox" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/ios_separator</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="boxCornerRadiusTopStart">@dimen/ios_control_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/ios_control_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/ios_control_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/ios_control_radius</item>
        <item name="hintTextColor">?attr/colorPrimary</item>
    </style>
    <style name="Widget.Ios.TextInputLayout.OutlinedBox.ExposedDropdownMenu" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxStrokeColor">@color/ios_separator</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="boxCornerRadiusTopStart">@dimen/ios_control_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/ios_control_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/ios_control_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/ios_control_radius</item>
        <item name="hintTextColor">?attr/colorPrimary</item>
    </style>

    <!-- Dialogs -->
    <style name="ThemeOverlay.Ios.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Ios.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Ios.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Ios.DialogButton</item>
    </style>
    <style name="Widget.Ios.DialogButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <style name="OverflowButtonStyle" parent="Widget.AppCompat.ActionButton.Overflow" />

    <!-- SearchView style without the hint icon -->
    <style name="AppSearchViewStyle" parent="Widget.AppCompat.SearchView.ActionBar">
        <item name="searchHintIcon">@null</item>
        <item name="android:textColor">?attr/colorOnBackground</item>
    </style>

    <style name="DangerText" parent="@android:style/TextAppearance">
        <item name="android:textColor">?attr/colorError</item>
    </style>

    <style name="FloatingActionButton" parent="@style/Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="tint">?attr/colorOnPrimary</item>
        <item name="elevation">4dp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Ios.Pill</item>
    </style>

    <style name="CardView" parent="@style/Widget.Ios.Card" />

    <style name="CardViewBackground" />

    <!-- Rounded corners in images -->
    <style name="roundedCornersImageView" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <!-- iOS-style preference rows with a consistent inset and type scale. -->
    <style name="PreferenceThemeOverlay.Ios" parent="PreferenceThemeOverlay">
        <item name="preferenceStyle">@style/Preference.Ios</item>
        <item name="dialogPreferenceStyle">@style/Preference.Ios.Dialog</item>
        <item name="editTextPreferenceStyle">@style/Preference.Ios.EditText</item>
        <item name="switchPreferenceCompatStyle">@style/Preference.Ios.Switch</item>
        <item name="preferenceCategoryStyle">@style/Preference.Ios.Category</item>
    </style>
    <style name="Preference.Ios" parent="@style/Preference">
        <item name="android:layout">@layout/preference_ios</item>
    </style>
    <style name="Preference.Ios.Dialog" parent="@style/Preference.DialogPreference">
        <item name="android:layout">@layout/preference_ios</item>
    </style>
    <style name="Preference.Ios.EditText" parent="@style/Preference.EditTextPreference">
        <item name="android:layout">@layout/preference_ios</item>
    </style>
    <style name="Preference.Ios.Switch" parent="@style/Preference.SwitchPreferenceCompat.Material">
        <item name="android:layout">@layout/preference_ios</item>
        <item name="widgetLayout">@layout/view_preference_switch</item>
    </style>
    <style name="Preference.Ios.Category" parent="@style/Preference.Category">
        <item name="android:textColor">@color/ios_label_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <!-- Action mode colors -->
    <style name="ActionMode" parent="@style/Widget.AppCompat.ActionMode">
        <item name="background">?attr/colorSurface</item>
        <item name="titleTextStyle">@style/ActionModeTitle</item>
    </style>
    <style name="ActionModeTitle" parent="@style/TextAppearance.AppCompat.Widget.ActionMode.Title">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="ActionModeCloseButtonStyle" parent="Widget.AppCompat.ActionButton.CloseMode">
        <item name="android:tint">?attr/colorOnSurface</item>
    </style>

    <!-- Inset warning cards -->
    <style name="BannerCardStyle" parent="Widget.Ios.Card">
        <item name="android:layout_marginStart">@dimen/ios_screen_padding</item>
        <item name="android:layout_marginEnd">@dimen/ios_screen_padding</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="cardBackgroundColor">@color/ios_orange_tint</item>
        <item name="strokeWidth">0dp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Ios.Medium</item>
    </style>

    <!-- Full-screen dialog style -->
    <style name="Theme.App.FullScreenDialog" parent="AppTheme">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/ios_background</item>
        <item name="android:windowLightStatusBar">@bool/ios_light_system_bars</item>
        <item name="android:windowAnimationStyle">@style/Animation.App.FullScreenDialog</item>
    </style>
    <style name="Animation.App.FullScreenDialog" parent="Animation.AppCompat.Dialog">
        <item name="android:windowEnterAnimation">@anim/slide_in_bottom</item>
        <item name="android:windowExitAnimation">@anim/slide_out_bottom</item>
    </style>
</resources>
