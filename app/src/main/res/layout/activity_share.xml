<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_background"
    android:fitsSystemWindows="true">

    <include
        android:id="@+id/app_bar_drawer"
        layout="@layout/app_bar_drawer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/share_root_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/ios_screen_padding"
            android:paddingTop="8dp"
            android:paddingEnd="@dimen/ios_screen_padding"
            android:paddingBottom="28dp">

            <ProgressBar
                android:id="@+id/share_progress"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="end"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="6dp"
                android:indeterminate="true"
                android:visibility="visible" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Ios.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/ios_card_padding">

                    <TextView
                        android:id="@+id/share_content_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/share_content_title"
                        android:textAppearance="@style/TextAppearance.Ios.SectionHeader" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/share_content_image"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:adjustViewBounds="true"
                        android:maxHeight="180dp"
                        android:scaleType="centerCrop"
                        android:visibility="visible"
                        app:shapeAppearanceOverlay="@style/roundedCornersImageView"
                        app:srcCompat="@drawable/ic_cancel_gray_24dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Ios.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="@string/share_content_text_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/share_content_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="start|top"
                            android:importantForAutofill="no"
                            android:inputType="textMultiLine|textCapSentences"
                            android:maxLines="10"
                            android:minLines="3"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:id="@+id/share_content_file_box"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="10dp"
                        android:visibility="visible">

                        <ImageView
                            android:id="@+id/share_content_file_icon"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:contentDescription="@null"
                            android:padding="7dp"
                            app:srcCompat="@drawable/ic_cancel_gray_24dp" />

                        <TextView
                            android:id="@+id/share_content_file_info"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="some file.mp3\n7.1 MB"
                            android:textAppearance="@style/TextAppearance.Ios.Footnote"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Ios.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/ios_card_padding">

                    <TextView
                        android:id="@+id/share_topic_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/share_topic_title"
                        android:textAppearance="@style/TextAppearance.Ios.SectionHeader" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Ios.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="@string/add_dialog_topic_name_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/share_topic_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAutofill="no"
                            android:inputType="text|textNoSuggestions"
                            android:maxLength="64"
                            android:maxLines="1"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <CheckBox
                        android:id="@+id/share_use_another_server_checkbox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:buttonTint="?attr/colorPrimary"
                        android:minHeight="44dp"
                        android:text="@string/add_dialog_use_another_server"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/share_base_url_layout"
                        style="@style/Widget.Ios.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:hint="@string/common_service_url"
                        android:visibility="visible"
                        app:endIconMode="dropdown_menu">

                        <AutoCompleteTextView
                            android:id="@+id/share_base_url_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/app_base_url"
                            android:inputType="textUri|textNoSuggestions"
                            android:maxLines="1"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/share_last_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:paddingBottom="4dp"
                        android:text="@string/share_suggested_topics"
                        android:textAlignment="viewStart"
                        android:textAppearance="@style/TextAppearance.Ios.SectionHeader" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/share_suggested_topics"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:clickable="true"
                        android:focusable="true"
                        android:nestedScrollingEnabled="false"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_ios_danger_banner"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:id="@+id/share_error_image"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:visibility="visible"
                            app:srcCompat="@drawable/ic_error_red_24dp"
                            app:tint="?attr/colorError" />

                        <TextView
                            android:id="@+id/share_error_text"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="Unable to resolve host example.com"
                            android:textAppearance="@style/TextAppearance.Ios.Footnote"
                            android:textColor="?attr/colorError"
                            android:visibility="visible" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
