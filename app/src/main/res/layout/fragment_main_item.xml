<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_item_card"
    style="@style/Widget.Ios.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/ios_list_spacing"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/ripple_ios_card"
    app:cardBackgroundColor="@color/ios_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal"
        android:padding="14dp">

        <ImageView
            android:id="@+id/main_item_image"
            android:layout_width="@dimen/ios_icon_tile_size"
            android:layout_height="@dimen/ios_icon_tile_size"
            android:background="@drawable/bg_ios_icon_tile"
            android:contentDescription="@null"
            android:padding="10dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/ic_sms_gray_24dp"
            app:tint="?attr/colorPrimary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="13dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/main_item_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="ntfy.sh/example"
                    android:textAppearance="@style/TextAppearance.Ios.CardTitle" />

                <TextView
                    android:id="@+id/main_item_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="10:13"
                    android:textAppearance="@style/TextAppearance.Ios.Footnote" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/main_item_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="89 notifications"
                    android:textAppearance="@style/TextAppearance.Ios.Footnote" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/main_item_connection_error_image"
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:layout_marginStart="4dp"
                        android:contentDescription="@null"
                        android:visibility="gone"
                        app:srcCompat="@drawable/ic_warning_amber_24dp"
                        app:tint="@color/ios_orange" />

                    <ImageView
                        android:id="@+id/main_item_notification_disabled_until_image"
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:layout_marginStart="4dp"
                        android:contentDescription="@null"
                        android:visibility="gone"
                        app:srcCompat="@drawable/ic_notifications_off_time_gray_outline_24dp"
                        app:tint="@color/ios_label_secondary" />

                    <ImageView
                        android:id="@+id/main_item_notification_disabled_forever_image"
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:layout_marginStart="4dp"
                        android:contentDescription="@null"
                        android:visibility="gone"
                        app:srcCompat="@drawable/ic_notifications_off_gray_outline_24dp"
                        app:tint="@color/ios_label_secondary" />

                    <ImageView
                        android:id="@+id/main_item_instant_image"
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:layout_marginStart="4dp"
                        android:contentDescription="@null"
                        android:visibility="gone"
                        app:srcCompat="@drawable/ic_bolt_gray_24dp"
                        app:tint="@color/ios_orange" />

                    <TextView
                        android:id="@+id/main_item_new"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_ios_badge"
                        android:gravity="center"
                        android:minWidth="20dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:text="99+"
                        android:textColor="@color/ios_badge_text"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
